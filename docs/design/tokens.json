      "light": [
        {
          "y": 2,
          "blur": 4,
          "spread": 0,
          "color": "#78460A",
          "alpha": 0.05
        },
        {
          "y": 12,
          "blur": 28,
          "spread": 0,
          "color": "#78460A",
          "alpha": 0.08
        }
      ],
      "dark": [
        {
          "y": 12,
          "blur": 28,
          "spread": 0,
          "color": "#000000",
          "alpha": 0.35
        }
      ],
      "darkInnerHighlight": "1 dp top inner line #FFFFFF @ 4%",
      "composeFallback": {
        "elevation": 4,
        "spotColor": "ext.shadowTint @ 0.20",
        "ambientColor": "ext.shadowTint @ 0.08"
      }
    },
    "ctaPrimary": {
