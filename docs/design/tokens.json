      "countdownTick": "no animation",
      "successCheck": "Applied: medallion scale 0.6->1.0 spring(dampingRatio 0.5, stiffness Medium ~ 350 ms) + HapticFeedbackType.Confirm; reduced motion: static medallion, haptic kept",
      "skeletonShimmer": "1200 ms linear loop; static grey when reduced motion",
      "confetti": "Applied (once per job): 24 particles (marigold 50%, forest 25%, terracotta 25%; rects 6x12 r3 and dots r3-5) burst from the medallion, gravity fall + fade, 1200 ms total, Canvas only, max 1 per screen; reduced motion / power saver: no confetti, the static 9-piece arrangement from the prototype is drawn instead",
      "ribbonAppear": "none (ribbon is static; colour change on IST midnight uses chipStateChange)",
      "navPill": "indicator width 0->64 dp + fade 200 ms emphasizedDecelerate (M3 NavigationBar default)",
      "proCard": "enters 300 ms after the medallion settles: fade + 24 dp slide-up, 300 ms emphasizedDecelerate"
    }
