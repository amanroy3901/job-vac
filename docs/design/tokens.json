      "navLabelCap": 1.5,
      "wordmarkScales": false,
      "stackButtonsAt": 1.5,
      "needsSignOff": "WCAG 1.4.4: capping nav labels at 1.5x and not scaling the wordmark (treated as a logo) must be signed off"
    }
