{
  "$description": "Sarkari Match design tokens v1.0 (W3C DTCG format). Source of truth for Compose theme (ui/theme/*.kt) and the HTML prototype. Colours verified WCAG AA (see 02-design-system.md §2.5).",
  "color": {
    "light": {
      "primary":                 { "$type": "color", "$value": "#1F4FB8" },
      "onPrimary":               { "$type": "color", "$value": "#FFFFFF" },
      "primaryContainer":        { "$type": "color", "$value": "#DCE5FF" },
      "onPrimaryContainer":      { "$type": "color", "$value": "#0B2A6E" },
      "secondary":               { "$type": "color", "$value": "#4E5B78" },
      "onSecondary":             { "$type": "color", "$value": "#FFFFFF" },
      "secondaryContainer":      { "$type": "color", "$value": "#E1E6F3" },
      "onSecondaryContainer":    { "$type": "color", "$value": "#1A2438" },
      "tertiary":                { "$type": "color", "$value": "#9A4A00", "$description": "Pro / saffron" },
      "onTertiary":              { "$type": "color", "$value": "#FFFFFF" },
      "tertiaryContainer":       { "$type": "color", "$value": "#FFE8CF" },
      "onTertiaryContainer":     { "$type": "color", "$value": "#5C2C00" },
      "error":                   { "$type": "color", "$value": "#B3261E" },
      "onError":                 { "$type": "color", "$value": "#FFFFFF" },
      "errorContainer":          { "$type": "color", "$value": "#FCE3E0" },
      "onErrorContainer":        { "$type": "color", "$value": "#7A1410" },
      "background":              { "$type": "color", "$value": "#F6F7FA" },
      "onBackground":            { "$type": "color", "$value": "#151A23" },
      "surface":                 { "$type": "color", "$value": "#F6F7FA" },
      "onSurface":               { "$type": "color", "$value": "#151A23" },
      "surfaceVariant":          { "$type": "color", "$value": "#ECEFF5" },
      "onSurfaceVariant":        { "$type": "color", "$value": "#4A5263" },
      "surfaceContainerLowest":  { "$type": "color", "$value": "#FFFFFF" },
      "surfaceContainerLow":     { "$type": "color", "$value": "#F1F3F8" },
      "surfaceContainer":        { "$type": "color", "$value": "#ECEFF5" },
      "surfaceContainerHigh":    { "$type": "color", "$value": "#E6E9F0" },
      "surfaceContainerHighest": { "$type": "color", "$value": "#E0E4EC" },
      "outline":                 { "$type": "color", "$value": "#737B8C" },
      "outlineVariant":          { "$type": "color", "$value": "#D3D8E2" },
      "inverseSurface":          { "$type": "color", "$value": "#2A2F38" },
      "inverseOnSurface":        { "$type": "color", "$value": "#EFF1F6" },
      "inversePrimary":          { "$type": "color", "$value": "#AEC4FF" },
      "scrim":                   { "$type": "color", "$value": "#000000", "$description": "use at 50% alpha" },
      "ext": {
        "success":             { "$type": "color", "$value": "#17713A" },
        "onSuccess":           { "$type": "color", "$value": "#FFFFFF" },
        "successContainer":    { "$type": "color", "$value": "#DDF2E3" },
        "onSuccessContainer":  { "$type": "color", "$value": "#0B4A24" },
        "warning":             { "$type": "color", "$value": "#8A5300" },
        "onWarning":           { "$type": "color", "$value": "#FFFFFF" },
        "warningContainer":    { "$type": "color", "$value": "#FFEFC7" },
        "onWarningContainer":  { "$type": "color", "$value": "#5A3600" },
        "urgent":              { "$type": "color", "$value": "#B93D0A" },
        "onUrgent":            { "$type": "color", "$value": "#FFFFFF" },
        "urgentContainer":     { "$type": "color", "$value": "#FFE6D8" },
        "onUrgentContainer":   { "$type": "color", "$value": "#6E2304" },
        "today":               { "$type": "color", "$value": "#B3261E" },
        "onToday":             { "$type": "color", "$value": "#FFFFFF" },
        "whatsappBrand":       { "$type": "color", "$value": "#25D366", "$description": "Only inside the official WhatsApp glyph. Never for text." }
      }
    },
    "dark": {
      "primary":                 { "$type": "color", "$value": "#AEC4FF" },
      "onPrimary":               { "$type": "color", "$value": "#0B2A6E" },
      "primaryContainer":        { "$type": "color", "$value": "#22408C" },
      "onPrimaryContainer":      { "$type": "color", "$value": "#DCE5FF" },
      "secondary":               { "$type": "color", "$value": "#BAC6E3" },
      "onSecondary":             { "$type": "color", "$value": "#24304A" },
      "secondaryContainer":      { "$type": "color", "$value": "#3A4660" },
      "onSecondaryContainer":    { "$type": "color", "$value": "#DCE3F7" },
      "tertiary":                { "$type": "color", "$value": "#FFB977" },
      "onTertiary":              { "$type": "color", "$value": "#4F2600" },
      "tertiaryContainer":       { "$type": "color", "$value": "#472500" },
      "onTertiaryContainer":     { "$type": "color", "$value": "#FFDDBC" },
      "error":                   { "$type": "color", "$value": "#FFB4AB" },
      "onError":                 { "$type": "color", "$value": "#690005" },
      "errorContainer":          { "$type": "color", "$value": "#5A1611" },
      "onErrorContainer":        { "$type": "color", "$value": "#FFDAD5" },
      "background":              { "$type": "color", "$value": "#11141B" },
      "onBackground":            { "$type": "color", "$value": "#E5E8EF" },
      "surface":                 { "$type": "color", "$value": "#11141B" },
      "onSurface":               { "$type": "color", "$value": "#E5E8EF" },
      "surfaceVariant":          { "$type": "color", "$value": "#2D3340" },
      "onSurfaceVariant":        { "$type": "color", "$value": "#B5BCC9" },
      "surfaceContainerLowest":  { "$type": "color", "$value": "#0C0F14" },
      "surfaceContainerLow":     { "$type": "color", "$value": "#171B23" },
      "surfaceContainer":        { "$type": "color", "$value": "#1B2029" },
      "surfaceContainerHigh":    { "$type": "color", "$value": "#232833" },
      "surfaceContainerHighest": { "$type": "color", "$value": "#2D3340" },
      "outline":                 { "$type": "color", "$value": "#8C93A1" },
      "outlineVariant":          { "$type": "color", "$value": "#3E4552" },
      "inverseSurface":          { "$type": "color", "$value": "#E5E8EF" },
      "inverseOnSurface":        { "$type": "color", "$value": "#2A2F38" },
      "inversePrimary":          { "$type": "color", "$value": "#1F4FB8" },
      "scrim":                   { "$type": "color", "$value": "#000000", "$description": "use at 60% alpha" },
      "ext": {
        "success":             { "$type": "color", "$value": "#7FD49A" },
        "onSuccess":           { "$type": "color", "$value": "#003919" },
        "successContainer":    { "$type": "color", "$value": "#123B22" },
        "onSuccessContainer":  { "$type": "color", "$value": "#C9F0D4" },
        "warning":             { "$type": "color", "$value": "#F1C25A" },
        "onWarning":           { "$type": "color", "$value": "#3F2D00" },
        "warningContainer":    { "$type": "color", "$value": "#3B2B06" },
        "onWarningContainer":  { "$type": "color", "$value": "#FFE3A3" },
        "urgent":              { "$type": "color", "$value": "#FFB28C" },
        "onUrgent":            { "$type": "color", "$value": "#511E00" },
        "urgentContainer":     { "$type": "color", "$value": "#4A1E07" },
        "onUrgentContainer":   { "$type": "color", "$value": "#FFDCCB" },
        "today":               { "$type": "color", "$value": "#FFB4AB" },
        "onToday":             { "$type": "color", "$value": "#410E0B" },
        "whatsappBrand":       { "$type": "color", "$value": "#25D366" }
      }
    }
  },
  "semantic": {
    "$description": "Map product states to colour roles. Every state ALSO has an icon + text (never colour alone).",
    "verdict.eligible":      { "container": "ext.successContainer", "content": "ext.onSuccessContainer", "accent": "ext.success", "icon": "check_circle", "symbol": "✓" },
    "verdict.checkYourself": { "container": "ext.warningContainer", "content": "ext.onWarningContainer", "accent": "ext.warning", "icon": "help", "symbol": "?" },
    "verdict.notEligible":   { "container": "errorContainer",       "content": "onErrorContainer",       "accent": "error",       "icon": "cancel", "symbol": "✗" },
    "deadline.calm":         { "container": "surfaceContainerHigh",  "content": "onSurfaceVariant",   "icon": "event",          "rule": "> 7 days left" },
    "deadline.soon":         { "container": "ext.warningContainer",  "content": "ext.onWarningContainer", "icon": "schedule",  "rule": "4–7 days left" },
    "deadline.urgent":       { "container": "ext.urgentContainer",   "content": "ext.onUrgentContainer",  "icon": "timer",     "rule": "1–3 days left" },
    "deadline.today":        { "container": "ext.today",             "content": "ext.onToday",            "icon": "alarm",     "rule": "last date is today (IST)" },
    "deadline.closed":       { "container": "surfaceContainerHighest","content": "onSurfaceVariant",  "icon": "event_busy",     "rule": "past last date" },
    "stage.done":            { "accent": "ext.success",  "icon": "check_circle" },
    "stage.current":         { "accent": "primary",      "icon": "radio_button_checked" },
    "stage.upcoming":        { "accent": "outline",      "icon": "radio_button_unchecked" },
    "stage.changed":         { "accent": "ext.warning",  "icon": "update" },
    "stage.missedOrCancelled": { "accent": "error",      "icon": "block" },
    "pro":                   { "container": "tertiaryContainer", "content": "onTertiaryContainer", "accent": "tertiary", "icon": "workspace_premium" }
  },
  "font": {
    "family": {
      "primary":  { "$type": "fontFamily", "$value": ["Mukta", "Noto Sans Devanagari", "sans-serif"], "$description": "Mukta (Ek Type, OFL) covers Devanagari + Latin in one harmonised design. Loaded as Downloadable Google Font (0 KB in APK) with bundled fallback = system Noto Sans Devanagari/Roboto." },
      "numeric":  { "$type": "fontFamily", "$value": ["Mukta", "sans-serif"], "$description": "Use fontFeatureSettings \"tnum\" where supported; countdown chips reserve min width." }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "displaySmall":   { "size": 32, "lineHeight": 44, "weight": 700, "use": "match-count hero number" },
      "headlineMedium": { "size": 26, "lineHeight": 36, "weight": 600, "use": "result / success headlines" },
      "headlineSmall":  { "size": 22, "lineHeight": 32, "weight": 600, "use": "onboarding question, screen hero" },
      "titleLarge":     { "size": 20, "lineHeight": 30, "weight": 600, "use": "top app bar title, sheet title" },
      "titleMedium":    { "size": 18, "lineHeight": 27, "weight": 600, "use": "job title on cards" },
      "titleSmall":     { "size": 16, "lineHeight": 24, "weight": 600, "use": "section header, card section label" },
      "bodyLarge":      { "size": 17, "lineHeight": 27, "weight": 400, "use": "onboarding body, explanations" },
      "bodyMedium":     { "size": 16, "lineHeight": 25, "weight": 400, "use": "default body" },
      "bodySmall":      { "size": 14, "lineHeight": 22, "weight": 400, "use": "metadata, helper text" },
      "labelLarge":     { "size": 16, "lineHeight": 22, "weight": 600, "use": "buttons" },
      "labelMedium":    { "size": 14, "lineHeight": 20, "weight": 500, "use": "chips, tabs, nav labels" },
      "labelSmall":     { "size": 13, "lineHeight": 18, "weight": 500, "use": "badges; NEVER smaller" }
    }
  },
  "space": { "$type": "dimension", "unit": "dp", "none": 0, "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24, "x3l": 32, "x4l": 40, "x5l": 48, "screenGutter": 16, "cardPadding": 16, "listGap": 12, "sectionGap": 24 },
  "radius": { "$type": "dimension", "unit": "dp", "none": 0, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 28, "full": 999 },
  "size": {
    "unit": "dp",
    "touchMin": 48, "buttonHeight": 52, "buttonHeightCompact": 40, "inputHeight": 56,
    "topAppBar": 64, "bottomNav": 80, "bottomActionBar": 84, "chipHeight": 36,
    "icon": { "xs": 16, "sm": 20, "md": 24, "lg": 32, "xl": 48, "illustration": 120 }
  },
  "elevation": { "$description": "Flat, tonal elevation. Shadows only on sticky bars & sheets.", "level0": 0, "level1": 1, "level2": 3, "level3": 6, "level4": 8, "level5": 12, "card": 0, "bottomActionBar": 3, "bottomNav": 3, "sheet": 1, "dialog": 6, "snackbar": 6 },
  "border": { "card": 1, "focusRing": 2, "selectedTile": 2 },
  "motion": {
    "duration": { "instant": 0, "short1": 50, "short2": 100, "short3": 150, "short4": 200, "medium1": 250, "medium2": 300, "medium4": 400, "long2": 500 },
    "easing": {
      "standard":              [0.2, 0.0, 0.0, 1.0],
      "emphasized":            [0.2, 0.0, 0.0, 1.0],
      "emphasizedDecelerate":  [0.05, 0.7, 0.1, 1.0],
      "emphasizedAccelerate":  [0.3, 0.0, 0.8, 0.15],
      "linear":                [0.0, 0.0, 1.0, 1.0]
    },
    "usage": {
      "pressFeedback": "ripple (M3 default) ≤100 ms",
      "screenForward": "fade-through + 30dp slide-in from end, 300 ms emphasizedDecelerate",
      "screenBack": "reverse, 200 ms emphasizedAccelerate; predictive back enabled",
      "sheetEnter": "300 ms emphasizedDecelerate", "sheetExit": "200 ms emphasizedAccelerate",
      "cardDismiss": "Modifier.animateItem(): fade 150 + placement 250",
      "chipStateChange": "150 ms standard (colour only)",
      "countdownTick": "no animation",
      "successCheck": "check icon scale 0.8→1 200 ms (skipped when reduced motion)",
      "skeletonShimmer": "1200 ms linear loop; static grey when reduced motion"
    }
  },
  "breakpoint": { "compact": 0, "medium": 600, "expanded": 840, "$description": "WindowSizeClass; content maxWidth 600dp centred on medium/expanded" }
}
