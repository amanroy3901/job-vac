  "semantic": {
    "$description": "Map product states to colour roles. Every state ALSO has an icon + text (never colour alone).",
    "verdict.eligible": {
      "container": "ext.successContainer",
      "content": "ext.onSuccessContainer",
      "accent": "ext.success",
      "icon": "check_circle",
      "symbol": "✓"
    },
    "verdict.checkYourself": {
      "container": "ext.warningContainer",
      "content": "ext.onWarningContainer",
      "accent": "ext.warning",
      "icon": "help",
      "symbol": "?"
    },
    "verdict.notEligible": {
      "container": "errorContainer",
      "content": "onErrorContainer",
      "accent": "error",
      "icon": "cancel",
      "symbol": "✗"
    },
    "deadline.calm": {
      "container": "ext.sunken",
      "content": "onSurface",
      "icon": "event",
      "rule": "> 7 days left",
      "ribbon": "none"
    },
    "deadline.soon": {
      "container": "ext.warningContainer",
      "content": "ext.onWarningContainer",
      "icon": "schedule",
      "rule": "4–7 days left",
      "ribbon": "none (chip only)"
    },
    "deadline.urgent": {
      "container": "ext.urgentContainer",
      "content": "ext.onUrgentContainer",
      "icon": "timer",
      "rule": "1–3 days left",
      "ribbon": "tinted (urgentContainer / onUrgentContainer), full card width"
    },
    "deadline.today": {
      "container": "ext.today",
      "content": "ext.onToday",
      "icon": "alarm",
      "rule": "last date is today (IST)",
      "ribbon": "filled (today / onToday), full card width"
    },
    "deadline.closed": {
      "container": "surfaceContainerHighest",
      "content": "onSurfaceVariant",
      "icon": "event_busy",
      "rule": "past last date",
      "ribbon": "none"
    },
    "stage.done": {
      "accent": "primary",
      "container": "primary",
      "content": "onPrimary",
      "icon": "check",
      "connector": "solid primary 2dp"
    },
    "stage.current": {
      "accent": "ext.marigold",
      "container": "ext.marigold",
      "content": "ext.onMarigold",
      "halo": "ext.marigoldContainer 4dp ring",
      "icon": "(stage icon)",
      "label": "· next / · अगला"
    },
    "stage.upcoming": {
      "accent": "outlineVariant",
      "container": "ext.card",
      "content": "onSurfaceVariant",
      "border": "2dp ext.hairline",
      "icon": "(stage icon)",
      "connector": "dashed 4/4 ext.hairline"
    },
    "stage.changed": {
      "accent": "ext.warning",
      "icon": "update"
    },
    "stage.missedOrCancelled": {
      "accent": "error",
      "icon": "block"
    },
    "pro": {
      "container": "tertiaryContainer",
      "content": "onTertiaryContainer",
      "accent": "ext.marigoldIcon",
      "fill": "tertiary",
      "onFill": "onTertiary",
      "icon": "workspace_premium"
    },
    "stage.locked": {
      "accent": "onSurfaceVariant",
      "pill": "ext.marigoldContainer / ext.onMarigoldContainer + lock icon + 'Pro'",
      "icon": "lock",
      "rule": "free user, stage after Applied"
    },
    "category": {
      "$description": "Category icon tiles (48 dp, radius 16). Mapping from post.org_type; anything else -> state. Icon + text label always nearby (the tile is recognition, not the only cue).",
      "police": "local_police",
      "ssc": "account_balance",
      "railway": "train",
      "bank": "savings",
      "state": "location_city"
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Baloo 2",
          "Noto Sans Devanagari",
          "sans-serif"
        ],
        "$description": "Headings, prices, calendar day numbers, hero counts. Weight 600 only. Devanagari + Latin in one family (Ek Type, OFL). Downloadable Google Font."
      },
      "primary": {
        "$type": "fontFamily",
        "$value": [
          "Hind",
          "Noto Sans Devanagari",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Body, labels, buttons. Weights 400 / 600. Devanagari + Latin (Indian Type Foundry, OFL). Downloadable Google Font; fallback = system Noto Sans Devanagari / Roboto."
      },
      "numeric": {
        "$type": "fontFamily",
        "$value": [
          "Baloo 2",
          "Hind",
          "sans-serif"
        ],
        "$description": "Big figures (Baloo 2) and inline figures (Hind) both use fontFeatureSettings \"tnum\"; Western digits in every locale (-u-nu-latn). Countdown chips reserve min width, never a fixed width."
      }
    },
    "weight": {
      "regular": 400,
      "semibold": 600
    },
    "scale": {
