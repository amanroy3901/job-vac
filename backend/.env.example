# Copy to .env for `make run` (local development). Never commit .env. Prod values come from Cloud Run env +
# Secret Manager; config validation refuses the dev modes below when APP_ENV=prod.

APP_ENV=local
# api | worker | admin | all  (all = local only: api + admin + a worker tick loop)
ROLE=all
ADDR=:8080
LOG_LEVEL=info
LOG_JSON=false

DATABASE_URL=postgres://postgres@127.0.0.1:5432/sarkari?sslmode=disable
# Integration tests create throwaway databases next to this one (role needs CREATEDB):
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres?sslmode=disable
DB_MAX_CONNS=10

# Firebase
FIREBASE_PROJECT_ID=sarkarimatch-stg
FIREBASE_PROJECT_NUMBER=000000000000
# firebase (verify ID tokens; sign_in_provider must be anonymous, google.com or apple.com) |
# dev ("Authorization: Bearer dev:<uid>[:google[:email]|:apple]")
AUTH_MODE=dev
# enforce | monitor | off
APP_CHECK_MODE=off
# comma list of allowed Firebase app ids, e.g. 1:123:android:abc
APP_CHECK_APP_IDS=

# Admin console: iap | dev (dev = X-Admin-Email header or ?as=<email>; the email must exist in admin_user)
ADMIN_AUTH_MODE=dev
# /projects/<number>/global/backendServices/<id>
IAP_AUDIENCE=

# Pub/Sub push (Play RTDN) + Cloud Scheduler ticks are authenticated with Google OIDC: oidc | off
PUSH_AUTH_MODE=off
RTDN_AUDIENCE=https://api.sarkarimatch.in/hooks/play-rtdn
RTDN_SERVICE_ACCOUNT=rtdn-pusher@sarkarimatch-stg.iam.gserviceaccount.com
TICK_AUDIENCE=https://worker.sarkarimatch.in
TICK_SERVICE_ACCOUNT=scheduler@sarkarimatch-stg.iam.gserviceaccount.com

# Google Play: google (Android Publisher API via ADC) | fake (accepts purchase tokens "fake:<base_plan_id>")
PLAY_PACKAGE_NAME=in.sarkarimatch.app
PLAY_MODE=fake

# App Store / StoreKit 2 (iOS): apple (verify JWS against the embedded Apple Root CA - G3) | fake (local only:
# trusts a per-process test PKI and decodes Xcode/LocalTesting StoreKit-configuration transactions unverified)
APPSTORE_MODE=fake
APPSTORE_BUNDLE_ID=in.sarkarimatch.app
# App Store Connect → App Information → Apple ID (required in prod for Production notifications)
APPSTORE_APP_APPLE_ID=0
APPSTORE_ENVIRONMENTS=Production,Sandbox
# Optional App Store Server API (In-App Purchase key, App Store Connect → Users and Access → Integrations).
# Empty = not used (the Apple-signed transaction JWS from the app is enough).
APPSTORE_API_KEY_ID=
APPSTORE_API_ISSUER_ID=
APPSTORE_API_KEY_PEM=
APPSTORE_API_SANDBOX=true

# Sign in with Apple token revocation on account deletion: apple | log
APPLE_SIGNIN_MODE=log
APPLE_TEAM_ID=
APPLE_SIWA_KEY_ID=
APPLE_SIWA_KEY_PEM=

# FCM HTTP v1: fcm (ADC) | log
FCM_MODE=log

# Catalog blob store: local | gcs
BLOB_MODE=local
BLOB_DIR=./var/blob
GCS_CATALOG_BUCKET=sm-catalog-stg
PUBLIC_BASE_URL=https://sarkarimatch.in
API_BASE_URL=https://api.sarkarimatch.in

# Keys (prod: Secret Manager). Empty = ephemeral/dev keys (refused in prod).
# ES256 P-256 private key, PKCS8 PEM (openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256)
ENTITLEMENT_KEY_PEM=
ENTITLEMENT_KEY_ID=ent-1
# 32 random bytes, base64 (openssl rand -base64 32)
SEAL_KEY_B64=

TICK_INTERVAL=15s
SHUTDOWN_WAIT=20s
